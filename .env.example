# Every variable Selects reads. Copy to .env for local use; .env is git-ignored.
# The server reads these only through server/src/config.ts.

# Required. Directory for the database and the session key, relative to where the server starts.
# `bun run dev` defaults it to ./data.
DATA_DIR=./data

# Optional. Port the server listens on. Default: 3000.
PORT=3000

# Optional. When set, the whole app asks for this password. Leave empty for no password.
# The password page belongs to `bun run start`; leave this empty under `bun run dev`.
SELECTS_PASSWORD=

# Optional. `true` starts Selects with posting paused, and holds any post that was under way for
# you to check. Set it for the first start on a restored backup, then remove it.
SELECTS_START_PAUSED=

# Which Instagram to publish to: `fake` (the default) or `live`.
# `fake` runs the fake Instagram server and a fake bucket inside Selects and ignores the bucket
# below: nothing leaves the install and nothing is posted for real. Set `live` only on the
# install that should post to the real Instagram API.
INSTAGRAM_API=fake

# Optional, and used only when INSTAGRAM_API=live. The S3-compatible bucket frames are uploaded
# to for Instagram to fetch. Without all four of the first variables Selects runs, and
# publishing is unavailable until they are set.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Optional. The bucket's region. Default: auto.
BUCKET_REGION=
# Optional. The public URL the bucket's objects are served from. Without it, Instagram is given
# a one-hour presigned link to each frame, and gallery output is unavailable. Publishing through
# a presigned link is not yet proven against Instagram: set this for now. In fake mode its value
# is not used, but setting it gives the fake bucket a public base URL, so gallery output can be
# tried.
BUCKET_PUBLIC_URL=

# Development only. Port of the Vite dev server that `bun run dev` starts. Default: 5173.
WEB_PORT=5173
